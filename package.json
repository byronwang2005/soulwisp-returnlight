{
  "name": "wangxu-returnlight", "version": "0.1.0", "private": true, "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "dev": "node scripts/dev.mjs", "setup": "node scripts/setup.mjs", "check": "tsc --noEmit",
    "build": "npm run build --workspace @wangxu/web && npm run build --workspace @wangxu/server",
    "test": "vitest run", "test:e2e": "playwright test", "health": "node scripts/health.mjs",
    "backup": "node scripts/backup.mjs", "restore": "node scripts/restore.mjs", "preview": "node scripts/dev.mjs --production",
    "package": "node scripts/package.mjs", "measure": "node --import tsx scripts/measure-simulation.ts"
  },
  "devDependencies": {"@playwright/test": "^1.56.0", "@types/node": "^24.0.0", "typescript": "^5.9.0", "vitest": "^5.0.3", "tsx": "^4.20.0"}
}
