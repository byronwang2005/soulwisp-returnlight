port: 7880
bind_addresses: ["0.0.0.0"]
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: false
  node_ip: REPLACE_PUBLIC_IPV4
room:
  auto_create: false
keys:
  REPLACE_API_KEY: REPLACE_API_SECRET
turn:
  enabled: true
  domain: turn.REPLACE_DOMAIN
  udp_port: 3478
  tls_port: 5349
  external_tls: true
  proxy_protocol: true
  proxy_protocol_trusted_cidrs: ["127.0.0.0/8", "::1/128"]
  relay_range_start: 50101
  relay_range_end: 50200
# Public TURN/TLS is :443; Caddy L4 terminates TLS and sends PROXY v2 to :5349.
# Never expose plaintext :5349 or the RoomService/API :7880 to the public Internet.
